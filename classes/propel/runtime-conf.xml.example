<?xml version="1.0" encoding="UTF-8"?>
<!--
  Used only when regenerating Propel config via convert-conf.
  Prefer classes/propel/build/conf/ffb-conf.php which reads .env / environment.
  Do not put real passwords in a committed runtime-conf.xml.
-->
<config>

 <log>
  <type>file</type>
  <name>./propel.log</name>
  <ident>propel-YOUR_DB_NAME</ident>
  <level>7</level>
  <conf></conf>
 </log>

 <propel>
  <datasources default="YOUR_DB_NAME">
   <datasource id="YOUR_DB_NAME">
    <adapter>mysql</adapter>
    <connection>
     <dsn>mysql:host=127.0.0.1;dbname=YOUR_DB_NAME;charset=utf8mb4</dsn>
     <user>YOUR_DB_USER</user>
     <password>YOUR_DB_PASSWORD</password>
    </connection>
   </datasource>
  </datasources>
 </propel>

</config>
