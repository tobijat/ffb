# Local secrets / environment for FFB.
# Copy to .env and fill in real values. .env is gitignored.

# Database
FFB_DB_HOST=127.0.0.1
FFB_DB_NAME=your_db_name
FFB_DB_USER=your_db_user
FFB_DB_PASSWORD=your_db_password
FFB_DB_CHARSET=utf8mb4

# reCAPTCHA
FFB_RECAPTCHA_PUBLICKEY=your_recaptcha_public_key
FFB_RECAPTCHA_PRIVATEKEY=your_recaptcha_private_key

# Optional: contract tests (defaults shown)
# FFB_TEST_BASE_URL=http://127.0.0.1:8765/
# FFB_TEST_USER=ffb_contract_tester
# FFB_TEST_PASSWORD=testpass123
