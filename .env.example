APP_NAME=FFB
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Shares the FFB MySQL database.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=your_db_name
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password

# File drivers keep Phase 2 free of Laravel schema migrations on the FFB DB.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# API auth uses the legacy PHPSESSID session by default.
# Set true only for local/smoke testing without a browser login.
# FFB_ALLOW_USER_ID_HEADER=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

# Local mail catcher (shared Mailpit outside this repo):
#   powershell -ExecutionPolicy Bypass -File "$env:LOCALAPPDATA\mailpit\start.ps1"
#   UI: http://127.0.0.1:8025
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@localhost"
MAIL_FROM_NAME="${APP_NAME}"

# Outbound HTTPS verify (Weltfussball scrape / Elo). Off by default when APP_ENV=local|testing
# (avoids cURL error 60 on Windows without a CA bundle). Set true in production if CA is OK.
# FFB_HTTP_VERIFY_SSL=false

# Default game for new registrations (ffb_game.game_id)
# FFB_REGISTRATION_DEFAULT_GAME_ID=25

VITE_APP_NAME="${APP_NAME}"
