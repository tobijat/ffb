{
    "name": "ffb/contract-tests",
    "description": "HTTP XML API contract tests for FFB AJAX endpoints",
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload-dev": {
        "psr-4": {
            "FFB\\Tests\\": "tests/"
        }
    },
    "config": {
        "vendor-dir": "tests/vendor",
        "sort-packages": true
    },
    "scripts": {
        "seed": "php tests/Support/seed_fixtures.php",
        "test": "@php tests/vendor/bin/phpunit"
    }
}
