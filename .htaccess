RewriteEngine on

# htaccess für FFB

# umleitung für wartungsarbeiten mit ausnahme
#Tobi Exception
#RewriteCond %{REMOTE_ADDR} !^77.119.129.73 [NC]
#RewriteCond %{REMOTE_ADDR} !^127.0.0.1 [NC]

#www.tobijat.at - Exception:
RewriteCond %{REMOTE_ADDR} !^85.13.134.41 [NC]

#Geri Exception
RewriteCond %{REMOTE_ADDR} !^84.115.136.168 [NC]

#Umleitung
#RewriteRule ^(.*)$ maintenance.html [L,QSA]

#WM Logo 2010
Redirect /images/ffb/backgrounds/wml2010.png http://upload.wikimedia.org/wikipedia/de/thumb/7/79/Logo_Fifa_World_Cup_2010_South_Africa.svg/525px-Logo_Fifa_World_Cup_2010_South_Africa.svg.png

# Static PDFs moved into Laravel public/
RewriteRule ^resource/(Registrierung|EM2016Gewinnspiel|WM2014Gewinnspiel)\.pdf$ /platform/public/resource/$1.pdf [R=301,L]

# Laravel platform (Phase 2 strangler) — keep out of legacy index.php.
# Use 307 (not 302) so POST bodies (login) survive the hop to /platform/public.
RewriteRule ^platform/public(?:/|$) - [L]
RewriteRule ^platform$ /platform/public/ [R=307,L]
RewriteCond %{REQUEST_URI} !^/platform/public
RewriteRule ^platform/(.*)$ /platform/public/$1 [R=307,L]

# ---------------------------------------------------------------------------
# Legacy player UI → platform (admin HTML pages migrate gradually; *.xml stay on index.php)
# ---------------------------------------------------------------------------
RewriteRule ^/?$ /platform/public/ [R=301,L]

RewriteCond %{REQUEST_URI} !\.xml$ [NC]
RewriteRule ^administration/news/?$ /platform/public/admin/news [R=301,L]

RewriteCond %{REQUEST_URI} !\.xml$ [NC]
RewriteRule ^users/?$ /platform/public/ [R=301,L]

RewriteCond %{REQUEST_URI} !\.xml$ [NC]
RewriteRule ^users/login(?:/.*)?$ /platform/public/ [R=301,L]

RewriteCond %{REQUEST_URI} !\.xml$ [NC]
RewriteRule ^users/logout(?:/.*)?$ /platform/public/logout [R=301,L]

RewriteCond %{REQUEST_URI} !\.xml$ [NC]
RewriteRule ^users/registration/activate-email(?:/.*)?$ /platform/public/registration/activate-email [R=301,L,QSA]

RewriteCond %{REQUEST_URI} !\.xml$ [NC]
RewriteRule ^users/registration/activate(?:/.*)?$ /platform/public/registration/activate [R=301,L,QSA]

RewriteCond %{REQUEST_URI} !\.xml$ [NC]
RewriteRule ^users/registration(?:/.*)?$ /platform/public/registration [R=301,L,QSA]

RewriteCond %{REQUEST_URI} !\.xml$ [NC]
RewriteRule ^users/accountDetails(?:/.*)?$ /platform/public/profile [R=301,L]

RewriteCond %{REQUEST_URI} !\.xml$ [NC]
RewriteRule ^users/account(?:/.*)?$ /platform/public/profile?tab=account [R=301,L,QSA]

RewriteCond %{REQUEST_URI} !\.xml$ [NC]
RewriteRule ^users/help(?:/.*)?$ /platform/public/help [R=301,L]

RewriteCond %{REQUEST_URI} !\.xml$ [NC]
RewriteRule ^users/reference(?:/.*)?$ /platform/public/reference [R=301,L]

RewriteCond %{REQUEST_URI} !\.xml$ [NC]
RewriteRule ^users/mailservice/cancel(?:/.*)?$ /platform/public/mailservice/cancel [R=301,L,QSA]

RewriteCond %{REQUEST_URI} !\.xml$ [NC]
RewriteRule ^ffb/?$ /platform/public/ [R=301,L]

RewriteCond %{REQUEST_URI} !\.xml$ [NC]
RewriteRule ^ffb/(lineup|myteam|bestteam|userscore)(?:/.*)?$ /platform/public/$1 [R=301,L]

RewriteCond %{REQUEST_URI} !\.xml$ [NC]
RewriteRule ^ffb/ /platform/public/ [R=301,L]

# Changes /index.php?module=users&class=login&event=getUser&presenter=html to /users/login/getUser.html
RewriteRule ^xd_receiver.htm(.*) - [L]
RewriteRule ^google7dab302111c988ed.html(.*) - [L]
RewriteRule ^script/ - [L]
RewriteRule ^images/ - [L]
RewriteRule ^include/ - [L]
RewriteRule ^modules/ - [L]
RewriteRule ^classes/ - [L]
RewriteRule ^parserfiles/ - [L]
RewriteRule ^resource/ - [L]
RewriteRule ^robots.txt - [L]

# Local dev: map localhost to ffb subdomain
RewriteCond %{HTTP_HOST}/%{REQUEST_FILENAME} !-d
RewriteCond %{HTTP_HOST}/%{REQUEST_FILENAME} !-f
RewriteCond %{HTTP_HOST} ^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
RewriteRule ^(.*)([^/]*)/([^/]*)/([^/]*)\.([^\.]*)$ index.php?module=$1&class=$3&event=$4&presenter=$5&subdomain=ffb [L,QSA]

RewriteCond %{HTTP_HOST}/%{REQUEST_FILENAME} !-d
RewriteCond %{HTTP_HOST}/%{REQUEST_FILENAME} !-f
RewriteCond %{HTTP_HOST} ^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
RewriteRule ^(.*)([^/]*)/([^/]*)$ index.php?module=$1&class=$3&subdomain=ffb [L,QSA]

RewriteCond %{HTTP_HOST}/%{REQUEST_FILENAME} !-d
RewriteCond %{HTTP_HOST}/%{REQUEST_FILENAME} !-f
RewriteCond %{HTTP_HOST} ^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
RewriteRule ^(.*)([^/]*)$ index.php?module=$1&subdomain=ffb [L,QSA]

RewriteCond %{HTTP_HOST}/%{REQUEST_FILENAME} !-d
RewriteCond %{HTTP_HOST}/%{REQUEST_FILENAME} !-f
RewriteCond %{HTTP_HOST} !^www\.(sportsfan\.at|sportsfan\.local)$ [NC]
RewriteCond %{HTTP_HOST} ^(www\.)?([a-z0-9_-]+)\.(sportsfan\.at|sportsfan\.local)$ [NC]
RewriteRule ^(.*)([^/]*)/([^/]*)/([^/]*)\.([^\.]*)$ index.php?module=$1&class=$3&event=$4&presenter=$5&subdomain=%2 [L,QSA]

# Changes /index.php?module=users&class=login to /users/login
RewriteRule ^script/ - [L]
RewriteRule ^images/ - [L]
RewriteRule ^include/ - [L]
RewriteRule ^modules/ - [L]
RewriteRule ^classes/ - [L]
RewriteRule ^parserfiles/ - [L]
RewriteRule ^resource/ - [L]
RewriteRule ^robots.txt - [L]
RewriteCond %{HTTP_HOST}/%{REQUEST_FILENAME} !-d
RewriteCond %{HTTP_HOST}/%{REQUEST_FILENAME} !-f
RewriteCond %{HTTP_HOST} !^www\.(sportsfan\.at|sportsfan\.local)$ [NC]
RewriteCond %{HTTP_HOST} ^(www\.)?([a-z0-9_-]+)\.(sportsfan\.at|sportsfan\.local)$ [NC]
RewriteRule ^(.*)([^/]*)/([^/]*)$ index.php?module=$1&class=$3&subdomain=%2 [L,QSA]

# Changes /index.php?module=welcome to /welcome
RewriteRule ^script/ - [L]
RewriteRule ^images/ - [L]
RewriteRule ^bilder/ - [L]
RewriteRule ^modules/ - [L]
RewriteRule ^classes/ - [L]
RewriteRule ^include/ - [L]
RewriteRule ^parserfiles/ - [L]
RewriteRule ^resource/ - [L]
RewriteRule ^robots.txt - [L]
RewriteCond %{HTTP_HOST}/%{REQUEST_FILENAME} !-d
RewriteCond %{HTTP_HOST}/%{REQUEST_FILENAME} !-f
RewriteCond %{HTTP_HOST} !^www\.(sportsfan\.at|sportsfan\.local)$ [NC]
RewriteCond %{HTTP_HOST} ^(www\.)?([a-z0-9_-]+)\.(sportsfan\.at|sportsfan\.local)$ [NC]
RewriteRule ^(.*)([^/]*)$ index.php?module=$1&subdomain=%2 [L,QSA]
